* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fb;
    color: #172033;
}

.demo-banner {
    background: #111827;
    color: white;
    text-align: center;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}

.navbar {
    height: 70px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 8%;
    border-bottom: 1px solid #e5e7eb;
}

.logo {
    font-size: 25px;
    font-weight: 800;
}

.logo span {
    color: #2563eb;
}

nav {
    display: flex;
    gap: 30px;
}

nav a {
    text-decoration: none;
    color: #374151;
    font-weight: 600;
}

.hero {
    min-height: 650px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    padding: 70px 8%;
}

.hero-content {
    max-width: 600px;
}

.small-title {
    color: #2563eb;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: 52px;
    line-height: 1.1;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #2563eb;
}

.description {
    font-size: 18px;
    line-height: 1.7;
    color: #667085;
    margin-bottom: 35px;
}

.primary-button {
    display: inline-block;
    background: #2563eb;
    color: white;
    text-decoration: none;
    padding: 15px 25px;
    border-radius: 8px;
    font-weight: bold;
}

.login-card {
    background: white;
    width: 380px;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
}

.login-card h2 {
    font-size: 28px;
    margin-bottom: 8px;
}

.login-subtitle {
    color: #667085;
    margin-bottom: 25px;
}

form {
    display: flex;
    flex-direction: column;
}

label {
    margin-bottom: 7px;
    font-size: 14px;
    font-weight: bold;
}

input {
    padding: 14px;
    margin-bottom: 18px;
    border: 1px solid #d1d5db;
    border-radius: 7px;
    font-size: 15px;
}

input:focus {
    outline: 2px solid #2563eb;
    border-color: transparent;
}

form button {
    padding: 14px;
    background: #2563eb;
    border: none;
    border-radius: 7px;
    color: white;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

#loginMessage {
    margin-top: 15px;
    text-align: center;
    font-size: 14px;
}

.demo-login {
    margin-top: 25px;
    padding: 15px;
    background: #eff6ff;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: #374151;
}

.features {
    background: white;
    padding: 70px 8%;
    text-align: center;
}

.features h2 {
    font-size: 32px;
    margin-bottom: 40px;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature {
    padding: 30px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}

.feature h3 {
    margin-bottom: 12px;
}

.feature p {
    color: #667085;
    line-height: 1.6;
}

footer {
    text-align: center;
    padding: 25px;
    color: #667085;
    font-size: 13px;
}

@media (max-width: 800px) {

    .hero {
        flex-direction: column;
        padding: 50px 5%;
    }

    .hero h1 {
        font-size: 40px;
    }

    .login-card {
        width: 100%;
        max-width: 400px;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

    nav {
        display: none;
    }
}